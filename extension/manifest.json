{
  "manifest_version": 3,
  "name": "IchWillNixVerpassen",
  "version": "1.3.3",
  "description": "Prüft Produkte verschiedener Shops ohne feste Artikelgrenze nacheinander und meldet die Lieferbarkeit per Telegram.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["https://api.telegram.org/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "IchWillNixVerpassen öffnen" },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
